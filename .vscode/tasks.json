{
    // Real Kotlin compiler errors from Gradle in the Problems panel. The Kotlin extension's own
    // diagnostics read sharedLogic from a prebuilt jar and can be stale; these tasks also refresh that jar.
    // Needs JAVA_HOME (or a system JDK) in the environment VS Code was started with.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Kotlin: check",
            "detail": "Compile shared logic (Android + iOS) and the Android app once",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "--console=plain",
                "--continue",
                ":sharedLogic:createFullJarAndroidMain",
                ":sharedLogic:compileKotlinIosSimulatorArm64",
                ":androidApp:compileDebugKotlin"
            ],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
            "problemMatcher": [
                {
                    "owner": "kotlin",
                    "source": "kotlinc",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^([ew]): file://(.+?):(\\d+):(\\d+) (.*)$",
                        "severity": 1, "file": 2, "line": 3, "column": 4, "message": 5
                    }
                }
            ]
        },
        {
            "label": "Kotlin: watch",
            "detail": "Recompile on every save and keep the Problems panel current",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "--continuous",
                "--console=plain",
                "--continue",
                ":sharedLogic:createFullJarAndroidMain",
                ":sharedLogic:compileKotlinIosSimulatorArm64",
                ":androidApp:compileDebugKotlin"
            ],
            "isBackground": true,
            "presentation": { "reveal": "silent", "panel": "dedicated" },
            "problemMatcher": [
                {
                    "owner": "kotlin",
                    "source": "kotlinc",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^([ew]): file://(.+?):(\\d+):(\\d+) (.*)$",
                        "severity": 1, "file": 2, "line": 3, "column": 4, "message": 5
                    },
                    "background": {
                        "activesBegin": "^(Starting a Gradle Daemon|Reusing configuration cache|Calculating task graph|Change detected)",
                        "activesEnd": "^Waiting for changes to input files"
                    }
                }
            ]
        },
        {
            "label": "Android: run on phone",
            "detail": "Build, install on the first real device (USB or wireless debugging) and open the app",
            "type": "shell",
            "command": "./scripts/android-run.sh phone",
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Android: run on emulator",
            "detail": "Build, install on the running emulator and open the app",
            "type": "shell",
            "command": "./scripts/android-run.sh emulator",
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "iOS: WebDriverAgent",
            "detail": "Reinstall and run WebDriverAgent on the booted simulator (for mobile-mcp)",
            "type": "shell",
            "command": "./scripts/wda-simulator.sh",
            "isBackground": true,
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "problemMatcher": {
                "owner": "wda",
                "pattern": { "regexp": "^(No booted iOS simulator.*)$", "message": 1 },
                "background": {
                    "activesBegin": "^Simulator: ",
                    "activesEnd": "ServerURLHere->"
                }
            }
        },
        {
            "label": "Server: new enrollment code",
            "detail": "Create a one-time code (valid 10 minutes) to register a device; the server must be running",
            "type": "shell",
            "command": "go",
            "args": ["run", ".", "enroll-code", "${input:enrollUser}"],
            // enroll-code reads config.json and admin.token next to the running server.
            "options": { "cwd": "${workspaceFolder}/../journal-server-go" },
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true, "focus": true },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "enrollUser",
            "type": "promptString",
            "description": "User to register the device for",
            "default": "hen"
        }
    ]
}
