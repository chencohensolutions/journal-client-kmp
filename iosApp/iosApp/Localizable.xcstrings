    },
    "Hidden on all your devices: %@. Not counted here." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסתר בכל המכשירים שלך: %@. לא נספר כאן."
          }
        }
      }
    },
    "Private settings can hide apps, screenshots of chosen apps and nudity on all your devices. Those files never reach this phone and aren't counted here." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדרות פרטיות יכולות להסתיר אפליקציות, צילומי מסך של אפליקציות שבחרת ועירום בכל המכשירים שלך. הקבצים האלה לא מגיעים לטלפון הזה ולא נספרים כאן."
          }
        }
      }
    },
