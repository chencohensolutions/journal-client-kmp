          "stringUnit" : {
            "state" : "translated",
            "value" : "המקור שהורד יימחק מהטלפון. הוא נשאר בשרת שלך, והתמונה תמשיך להופיע כאן מהתצוגה המקדימה שלה."
          }
        }
      }
    },
    "The key created for this attempt was deleted from the device." : {
      "localizations" : {
        "he" : {
