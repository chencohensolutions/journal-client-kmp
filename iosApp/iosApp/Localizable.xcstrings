                      "state" : "translated",
                      "value" : "%arg סוגים מוסתרים בכל המכשירים שלך"
                    }
                  },
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "סוג אחד מוסתר בכל המכשירים שלך"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg סוגים מוסתרים בכל המכשירים שלך"
                    }
                  },
                  "two" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "שני סוגים מוסתרים בכל המכשירים שלך"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Share JPEG XL as JPEG" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שיתוף JPEG XL כ-JPEG"
          }
        }
      }
    },
    "Photos kept as JPEG XL are shared as the JPEG they were made from, exactly as it was, so every app can open them. Off, they are shared as JPEG XL." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תמונות שנשמרו כ-JPEG XL משותפות כקובץ ה-JPEG שממנו נוצרו, בדיוק כפי שהיה, כדי שכל אפליקציה תוכל לפתוח אותן. כשההגדרה כבויה, הן משותפות כ-JPEG XL."
          }
        }
      }
    },
    "Quick image while scrolling" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תמונה מהירה בזמן גלילה"
          }
        }
      }
    },
    "Photos only on the server show a small image at once, and the sharp one when you stop scrolling. A smaller image loads faster but looks softer." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תמונות שנמצאות רק בשרת מוצגות מיד בתמונה קטנה, והחדה מופיעה כשמפסיקים לגלול. תמונה קטנה יותר נטענת מהר יותר אבל רכה יותר."
          }
        }
      }
    },
    "Width, of the screen's" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רוחב, מתוך רוחב המסך"
          }
        }
      }
    },
    "None" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ללא"
          }
        }
      }
    },
    "Recordings as FLAC" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקלטות כ-FLAC"
          }
        }
      }
    },
    "WAVs stay as they are." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קובצי WAV נשארים כמו שהם."
          }
        }
      }
    },
    "FLAC replaces each WAV once the server has it: about half the space." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FLAC מחליף כל WAV כשהשרת מחזיק אותו: כמחצית מהמקום."
          }
        }
      }
    },
    "The server keeps recordings as FLAC and photos as JPEG XL, from which the very same WAV or JPEG comes back." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת שומר הקלטות כ-FLAC ותמונות כ-JPEG XL, ומהם חוזר בדיוק אותו WAV או JPEG."
          }
        }
      }
    },
    "Private media, nudity, sound recordings, apps and screenshots by app" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מדיה פרטית, עירום, הקלטות קול, אפליקציות וצילומי מסך לפי אפליקציה"
          }
        }
      }
    },
    "Your cameras" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המצלמות שלך"
          }
        }
      }
    },
    "Every camera that took your photos and videos, as their tags say. Turn off one that isn’t yours: its photos move to Sent to you, on all your devices." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל מצלמה שצילמה את התמונות והסרטונים שלך, לפי התגים שלהם. כבה מצלמה שאינה שלך: התמונות שלה יעברו אל נשלח אליך, בכל המכשירים שלך."
          }
        }
      }
    },
    "A camera you haven’t marked counts as yours, so nothing moves until you choose." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצלמה שלא סימנת נחשבת שלך, כך ששום דבר לא זז עד שתבחר."
          }
        }
      }
    },
    "Mine" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלי"
          }
        }
      }
    },
    "Its photos are in Sent to you" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התמונות שלה בנשלח אליך"
          }
        }
      }
    },
    "Move" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העבר"
          }
        }
      }
    },
    "They stay on your server and in the app, under Sent to you instead of Camera. Mark the %@ yours again to bring them back." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הן נשארות בשרת שלך ובאפליקציה, תחת נשלח אליך במקום מצלמה. סמן את %@ כשלך שוב כדי להחזיר אותן."
          }
        }
      }
    },
