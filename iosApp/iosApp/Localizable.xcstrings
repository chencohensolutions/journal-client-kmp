          "stringUnit" : {
            "state" : "translated",
            "value" : "המכשיר מחובר"
          }
        }
      }
    },
    "Your journal server only talks to devices it knows. Registering creates a private key on this iPhone. The key never leaves it." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שרת היומן שלך מדבר רק עם מכשירים שהוא מכיר. הרישום יוצר מפתח פרטי באייפון הזה, והמפתח אף פעם לא יוצא ממנו."
          }
