    "That code didn't work" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקוד הזה לא עבד"
          }
        }
      }
    },
    "The Keychain failed: %@" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שגיאה ב-Keychain: %@"
