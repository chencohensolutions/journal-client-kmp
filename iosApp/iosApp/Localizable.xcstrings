    "%@ can’t see your photos, only their sizes. A passphrase opens the copy: lose it and the copy is lost." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ לא יכול לראות את התמונות, רק את הגודל שלהן. סיסמה פותחת את העותק: אם היא אובדת, העותק אובד."
          }
        }
      }
    },
    "%@ could open your photos. Nothing to remember." : {
