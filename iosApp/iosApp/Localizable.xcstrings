      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תארו במילים שלכם מה יש בתמונה: \"כלב על החוף בשקיעה\", \"עוגת יום הולדת\", \"שלג בהרים\". החיפוש מסתכל על התמונות עצמן, לא על השמות שלהן."
          }
