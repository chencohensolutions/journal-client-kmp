    },
    "The certificate was issued, but signing in with it failed: %@" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התעודה הונפקה, אבל ההתחברות איתה נכשלה: %@"
