      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תיקיות קול"
          }
        }
      }
    },
    "Their recordings are phone calls, in Calls on all your devices." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההקלטות שלהן הן שיחות טלפון, תחת שיחות בכל המכשירים שלך."
          }
        }
      }
    },
    "Their recordings are in Voice recordings on all your devices." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההקלטות שלהן תחת הקלטות קול בכל המכשירים שלך."
          }
        }
      }
    },
    "Kept as folders" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תיקיות נפרדות"
          }
        }
      }
    },
    "Each stays a folder of its own, until you move it." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל אחת נשארת תיקייה בפני עצמה, עד שתעביר אותה."
          }
        }
      }
    },
    "No folder yet" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין אין תיקייה"
          }
        }
      }
    },
