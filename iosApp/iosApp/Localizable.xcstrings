      }
    },
    "%@’s server refused the code: it was used or expired. Ask %@ for a new invite." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת של %1$@ דחה את הקוד: כבר השתמשו בו או שפג תוקפו. בקשו מ%2$@ הזמנה חדשה."
          }
        }
      }
    },
    "%@’s server will be refused from now on." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת של %@ יידחה מעכשיו."
