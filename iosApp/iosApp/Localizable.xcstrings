    "+%lld %@ hidden" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עוד %1$lld מ%2$@ מוסתרים"
          }
        }
      }
    },
    "1. Install journal-server on a new PC.\n2. Ask %@ to let your new server take over the copy, then join it.\n3. Run: journal-server restore <user> --from %@ --to <an empty folder> --passphrase\n   and type the six words." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. התקינו את journal-server במחשב חדש.\n2. בקשו מ%1$@ לתת לשרת החדש שלכם להשתלט על העותק, והצטרפו אליו.\n3. הריצו: journal-server restore <user> --from %2$@ --to <תיקייה ריקה> --passphrase\n   והקלידו את שש המילים."
          }
        }
      }
    },
    "8 letters and digits. Works once, expires 10 minutes after it was created." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 אותיות וספרות. עובד פעם אחת, ותוקפו פג 10 דקות אחרי שנוצר."
          }
        }
      }
    },
    "A new key will be created in this iPhone's Secure Enclave. It can't be copied, exported or backed up." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפתח חדש ייווצר ב-Secure Enclave של האייפון הזה. אי אפשר להעתיק, לייצא או לגבות אותו."
          }
        }
      }
    },
    "A new row starts after a break without photos, so an evening that runs past midnight stays in one row." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שורה חדשה מתחילה אחרי הפסקה בלי תמונות, כך שערב שנמשך אחרי חצות נשאר בשורה אחת."
          }
        }
      }
    },
    "A trip" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טיול"
          }
        }
      }
    },
    "About a third smaller than WebP at the same quality." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קטן בכשליש מ־WebP באותה איכות."
          }
        }
      }
    },
    "Accept" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אישור"
          }
        }
      }
    },
    "Accept and your copy goes to %@’s server as well. The offer lasts about %lld more min." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם תאשרו, העותק שלכם יישלח גם לשרת של %1$@. ההצעה בתוקף עוד כ-%2$lld דק׳."
          }
        }
      }
    },
