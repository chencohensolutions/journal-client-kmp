      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העבר אל…"
          }
        }
      }
    },
    "Only how they are labelled changes, on your server: the recordings themselves stay as they are." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק התווית שלהם משתנה, בשרת שלך: ההקלטות עצמן נשארות כמו שהן."
          }
        }
      }
    },
    "On your server. You can leave this page; Moments follows in a moment." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בשרת שלך. אפשר לצאת מהעמוד; רגעים יתעדכנו בקרוב."
          }
        }
      }
    },
    "WhatsApp voice messages always stay voice messages." : {
