      }
    },
    "How much to keep for them" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה מקום לשמור לו"
          }
        }
      }
    },
    "How sure the server’s scan must be that a photo shows nudity to hide it. Lower hides more, including some that show none." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה הסריקה בשרת צריכה להיות בטוחה שתמונה מציגה עירום כדי להסתיר אותה. נמוך יותר מסתיר יותר, כולל כמה שאין בהן עירום."
          }
        }
      }
    },
    "How your copy is kept" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
