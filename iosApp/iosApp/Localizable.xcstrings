        }
      }
    },
    "The key created for this attempt was deleted from the device." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המפתח שנוצר בניסיון הזה נמחק מהמכשיר."
          }
        }
      }
    },
    "The photo itself isn't changed." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התמונה עצמה לא משתנה."
          }
        }
      }
    },
    "The server could not process this device's certificate request." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת לא הצליח לעבד את בקשת התעודה של המכשיר הזה."
          }
        }
      }
    },
    "The server doesn't accept this device's certificate anymore. Register it again with a new enrollment code." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת כבר לא מקבל את התעודה של המכשיר הזה. רשמו אותו מחדש עם קוד רישום חדש."
          }
        }
