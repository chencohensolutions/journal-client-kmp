            "value" : "גבוה"
          }
        }
      }
    },
    "Tap a photo or group to change its size, place or focus." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקישו על תמונה או קבוצה כדי לשנות את הגודל, המקום או המיקוד שלה."
          }
        }
      }
    },
    "Tap the part that should stay in view; the frame shows what the tile will show." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקישו על החלק שצריך להישאר גלוי; המסגרת מראה מה יוצג באריח."
          }
        }
