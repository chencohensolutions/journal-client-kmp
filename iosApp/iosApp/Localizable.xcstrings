    "The server issues a certificate" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת מנפיק תעודה"
          }
        }
      }
    },
    "The server rejected %@. It may be mistyped, expired or already used. Each code works once, for 10 minutes." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השרת דחה את %@. ייתכן שהוקלד לא נכון, שתוקפו פג או שכבר השתמשו בו. כל קוד עובד פעם אחת, למשך 10 דקות."
          }
        }
      }
    },
    "The story and its title go away. Its photos and videos stay on this device." : {
      "localizations" : {
