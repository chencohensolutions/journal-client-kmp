    "Of what was imported" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתוך מה שיובא"
          }
        }
      }
    },
    "%@: files whose name and folder say nothing: downloads, saved images, files from a computer." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: קבצים שהשם והתיקייה שלהם לא מספרים דבר: הורדות, תמונות שנשמרו, קבצים ממחשב."
