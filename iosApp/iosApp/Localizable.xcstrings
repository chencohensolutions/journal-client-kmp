    "%@’s offer is gone: it lasts 10 minutes." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההצעה של %@ כבר לא בתוקף: היא נמשכת 10 דקות."
          }
        }
      }
    },
    "%@’s phone now offers to keep their copy here." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
