    "High" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גבוהה"
          }
        }
      }
    },
    "Higher: only photos that look nearly the same are set together. Lower: bigger sets, less alike." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גבוה יותר: רק תמונות כמעט זהות מקובצות יחד. נמוך יותר: קבוצות גדולות יותר, פחות דומות."
          }
        }
      }
    },
    "Higher: only photos that look nearly the same are suggested together. Lower: more photos in each suggestion, but less alike." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גבוה יותר: רק תמונות שנראות כמעט זהות מוצעות יחד. נמוך יותר: יותר תמונות בכל הצעה, אבל פחות דומות."
          }
        }
      }
    },
    "History" : {
      "localizations" : {
