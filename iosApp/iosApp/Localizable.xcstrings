    "192.168.50.150:8080" : {
      "shouldTranslate" : false
    },
    "8 letters and digits. Works once, expires 10 minutes after it was created." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 אותיות וספרות. עובד פעם אחת, ותוקפו פג 10 דקות אחרי שנוצר."
          }
        }
      }
    },
    "A new key will be created in this iPhone's Secure Enclave. It can't be copied, exported or backed up." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפתח חדש ייווצר ב-Secure Enclave של האייפון הזה. אי אפשר להעתיק, לייצא או לגבות אותו."
          }
        }
      }
    },
    "A new row starts after a break without photos, so an evening that runs past midnight stays in one row." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שורה חדשה מתחילה אחרי הפסקה בלי תמונות, כך שערב שנמשך אחרי חצות נשאר בשורה אחת."
          }
        }
      }
    },
    "A trip" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טיול"
          }
        }
      }
    },
    "A video only on your server doesn’t play in the app yet; it shows a frame of it. Download the original to play it again." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סרטון שנמצא רק בשרת עדיין לא מתנגן באפליקציה; מוצגת תמונה ממנו. אפשר להוריד את המקור כדי לנגן אותו שוב."
          }
        }
      }
    },
    "About a third smaller than WebP at the same quality." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קטן בכשליש מ־WebP באותה איכות."
          }
        }
      }
    },
    "Account" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חשבון"
          }
        }
      }
    },
