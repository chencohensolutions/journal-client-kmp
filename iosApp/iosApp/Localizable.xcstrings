            "value" : "הכול מגובה"
          }
        }
      }
    },
    "To hide a kind on this phone, or show it again, use the filter bar in Moments. This phone remembers it." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להסתיר סוג בטלפון הזה, או להציג אותו שוב, השתמשו בסרגל הסינון ברגעים. הטלפון הזה זוכר את הבחירה."
          }
        }
      }
    },
    "%lld kinds hidden on all your devices" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@n@"
          },
          "substitutions" : {
