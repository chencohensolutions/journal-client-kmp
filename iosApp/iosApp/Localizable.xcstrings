        }
      }
    },
    "Show on all your devices" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להציג בכל המכשירים שלך"
          }
        }
      }
    },
    "Turn a kind off to hide it on all your devices: not in the library, its counts or search. Nothing is deleted. This page opens only with the phone's lock." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבו סוג כדי להסתיר אותו בכל המכשירים שלך: לא בספרייה, בספירות או בחיפוש. שום דבר לא נמחק. העמוד נפתח רק עם נעילת הטלפון."
          }
        }
      }
    },
    "%@ · Hidden on all your devices" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · מוסתר בכל המכשירים שלך"
          }
        }
      }
    },
    "%@ · by the app they were taken in" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · לפי האפליקציה שבה צולמו"
