{
  "sourceLanguage": "en",
  "strings": {
    "%lld of %lld": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld מתוך %2$lld"
          }
        }
      }
    },
    "%lld photos": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld תמונות"
          }
        }
      }
    },
    "%lld photos · %lld days": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld תמונות · %2$lld ימים"
          }
        }
      }
    },
    "4:5": {
      "shouldTranslate": false
    },
    "All photos": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל התמונות"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סגירה"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיום"
          }
        }
      }
    },
    "Each day shows its own photos, with a link to the whole moment.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל יום מציג את התמונות שלו, עם קישור לרגע כולו."
          }
        }
      }
    },
    "Every day it has": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בכל יום שלו"
          }
        }
      }
    },
    "Fast": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מהיר"
          }
        }
      }
    },
    "Hold a photo for more": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזיקו תמונה לעוד"
          }
        }
      }
    },
    "Hold and slide to flip": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזיקו והחליקו כדי לדפדף"
          }
        }
      }
    },
    "Its photos leave their days and show here together.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונות עוזבות את הימים שלהן ומוצגות כאן יחד."
          }
        }
      }
    },
    "Main": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ראשית"
          }
