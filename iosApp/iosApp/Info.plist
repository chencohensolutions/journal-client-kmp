<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Journal reads the Wi-Fi network's name, so backup runs only on the networks you chose. It doesn't keep or send your location.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Journal shows your photos and videos by day and backs them up to your own server.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Journal connects to your journal server on the local network.</string>
	<key>NSCameraUsageDescription</key>
	<string>Journal scans the enrollment QR code your server shows.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Journal uses Face ID to open Hidden collections.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.chencohensolution.journal.backup.processing</string>
		<string>com.chencohensolution.journal.backup.refresh</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.chencohensolution.journal.enroll</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>journal</string>
			</array>
		</dict>
	</array>
</dict>
</plist>