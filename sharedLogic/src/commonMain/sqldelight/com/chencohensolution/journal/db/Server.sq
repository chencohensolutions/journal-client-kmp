-- What the server holds, as its change feed describes it (ServerLibrary): one row per photo, video or sound recording.
-- Written a page of the feed at a time; a cache, read again from the feed when lost.
CREATE TABLE server_media (
    sha256 TEXT NOT NULL PRIMARY KEY,
    is_video INTEGER AS kotlin.Boolean NOT NULL,
    is_audio INTEGER AS kotlin.Boolean NOT NULL,
    file_name TEXT NOT NULL,
    mime_type TEXT NOT NULL,
    size INTEGER NOT NULL,
    -- RFC 3339 with the offset of where it was taken, as the uploading device sent it.
    taken_at TEXT,
    -- taken_at (else uploaded_at) as epoch milliseconds, for ordering by time.
    taken_millis INTEGER NOT NULL,
    width INTEGER,
    height INTEGER,
    duration_millis INTEGER,
    latitude REAL,
    longitude REAL,
    source TEXT,
    uploaded_at TEXT NOT NULL,
    nudity REAL,
    is_private INTEGER AS kotlin.Boolean NOT NULL,
    aesthetic REAL,
    is_call INTEGER AS kotlin.Boolean NOT NULL,
    call_contact TEXT,
    call_number TEXT,
    -- The device that uploaded it, or "import" for what the server's import placed (since version 9).
    uploaded_by TEXT,
    -- The app on screen in a screenshot, and the camera its tags name (since version 9).
    screenshot_app TEXT,
    camera_make TEXT,
    camera_model TEXT
);

-- The files the user hides on every device (ServerLibrary.hidden): the server sends nothing more of them.
CREATE TABLE server_hidden (
    sha256 TEXT NOT NULL PRIMARY KEY
);

-- In the order the rows were written (an INSERT OR REPLACE writes a row anew), as the list in memory held them.
allMedia:
SELECT * FROM server_media ORDER BY rowid;

-- One file by its sha256.
mediaWithSha:
SELECT * FROM server_media WHERE sha256 = ?;

-- The first file written with this name and size, its case aside as library_item matches them: the server's copy of a
-- phone photo backup hasn't read.
shaNamedAs:
SELECT sha256 FROM server_media WHERE lower(file_name) = lower(:name) AND size = :size ORDER BY rowid LIMIT 1;

-- The sound recordings, in the order the rows were written.
audioMedia:
SELECT * FROM server_media WHERE is_audio = 1 ORDER BY rowid;

-- The few facts of every file that the phone's search and people read (where and when, and whether private).
mediaFacts:
SELECT sha256, taken_at, uploaded_at, latitude, longitude, is_private FROM server_media;

countMedia:
SELECT count(*) FROM server_media;

upsertMedia:
INSERT OR REPLACE INTO server_media VALUES ?;

deleteMedia:
DELETE FROM server_media WHERE sha256 = ?;

allHidden:
SELECT sha256 FROM server_hidden;

addHidden:
INSERT OR IGNORE INTO server_hidden VALUES (?);

removeHidden:
DELETE FROM server_hidden WHERE sha256 = ?;

-- Files marked private while "Show private media" is off: only what hides this phone's own copy of each (its sha256,
-- else its name and size, as the library matches them). Nothing else of them is kept until private media is shown.
CREATE TABLE server_private (
    sha256 TEXT NOT NULL PRIMARY KEY,
    file_name TEXT NOT NULL,
    size INTEGER NOT NULL
);

allPrivate:
SELECT * FROM server_private;

addPrivate:
INSERT OR REPLACE INTO server_private VALUES (?, ?, ?);

removePrivate:
DELETE FROM server_private WHERE sha256 = ?;

privateMediaToKeys:
INSERT OR REPLACE INTO server_private SELECT sha256, file_name, size FROM server_media WHERE is_private;

deletePrivateMedia:
DELETE FROM server_media WHERE is_private;

clearPrivate:
DELETE FROM server_private;

clearMedia:
DELETE FROM server_media;

clearHidden:
DELETE FROM server_hidden;

-- The made-up library's files (debug builds, MadeUpLibrary): their sha256s start with this prefix.
deleteMadeUpMedia:
DELETE FROM server_media WHERE substr(sha256, 1, 8) = '0000made';

-- How the server names each folder source ("folder:calls" is "Calls"), from its folderNames once per sync (since
-- version 9): the app shows folders by it (FolderNames), also before the server answers.
CREATE TABLE server_folder_name (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL
);

allFolderNames:
SELECT id, name FROM server_folder_name;

clearFolderNames:
DELETE FROM server_folder_name;

addFolderName:
INSERT OR REPLACE INTO server_folder_name VALUES (?, ?);
