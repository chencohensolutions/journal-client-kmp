-- Moments' rows (FeedTable): one per row of the feed, made a window of days at a time from library_item. A row keeps
-- its structure by item ids (data, JSON: FeedSectionData); the items themselves are read from library_item.
CREATE TABLE feed_section (
    key TEXT NOT NULL PRIMARY KEY,
    -- The oldest and newest days of its row, as days since 1970-01-01.
    first_day INTEGER NOT NULL,
    last_day INTEGER NOT NULL,
    -- Its newest moment: the feed's order, newest first.
    newest_millis INTEGER NOT NULL,
    -- Its shown photos per day, newest first, as "day:count,day:count" (days since 1970-01-01): the timeline.
    day_counts TEXT NOT NULL,
    data TEXT NOT NULL
);

CREATE INDEX feed_section_order ON feed_section(newest_millis);
CREATE INDEX feed_section_days ON feed_section(first_day, last_day);

-- Days whose items changed since Moments' rows were made, noted by the triggers on library_item; -1 for all of them.
CREATE TABLE feed_dirty (
    day INTEGER NOT NULL PRIMARY KEY,
    -- Which noting it is: noting a day again replaces it with a higher number, so a refresh clears only the notings it
    -- read, and a day noted again while its rows were being made is made again next time.
    n INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX feed_dirty_n ON feed_dirty(n);

-- The sound recordings Moments' rows were made with (FeedTable): each refresh compares them with the recordings now
-- shown, and makes the rows of the days of those that came, went or changed again, also after a restart.
CREATE TABLE feed_sound (
    sha256 TEXT NOT NULL PRIMARY KEY,
    -- Its day, as days since 1970-01-01.
    epoch_day INTEGER NOT NULL,
    -- What the rows show of it (kind, start, length, private), to tell a change.
    facts TEXT NOT NULL
);

CREATE TRIGGER library_item_added AFTER INSERT ON library_item BEGIN
    INSERT OR REPLACE INTO feed_dirty VALUES (new.epoch_day, (SELECT coalesce(max(n), 0) + 1 FROM feed_dirty));
END;
CREATE TRIGGER library_item_changed AFTER UPDATE ON library_item BEGIN
    INSERT OR REPLACE INTO feed_dirty VALUES (old.epoch_day, (SELECT coalesce(max(n), 0) + 1 FROM feed_dirty));
    INSERT OR REPLACE INTO feed_dirty VALUES (new.epoch_day, (SELECT coalesce(max(n), 0) + 1 FROM feed_dirty));
END;
CREATE TRIGGER library_item_gone AFTER DELETE ON library_item BEGIN
    INSERT OR REPLACE INTO feed_dirty VALUES (old.epoch_day, (SELECT coalesce(max(n), 0) + 1 FROM feed_dirty));
END;
CREATE TRIGGER library_item_replacing BEFORE INSERT ON library_item BEGIN
    INSERT OR REPLACE INTO feed_dirty SELECT epoch_day, (SELECT coalesce(max(n), 0) + 1 FROM feed_dirty) FROM library_item WHERE id = new.id;
END;

-- A new database has no rows yet: make them all once.
INSERT INTO feed_dirty VALUES (-1, 0);

-- The items of days first..last (as days since 1970-01-01), newest first, as LibraryController orders a day.
itemsOfDays:
SELECT * FROM library_item WHERE epoch_day BETWEEN ? AND ? ORDER BY taken_millis DESC, id ASC;

newestBeforeDay:
SELECT * FROM library_item WHERE epoch_day < ? ORDER BY epoch_day DESC, taken_millis DESC, id ASC LIMIT 1;

oldestAfterDay:
SELECT * FROM library_item WHERE epoch_day > ? ORDER BY epoch_day ASC, taken_millis ASC, id DESC LIMIT 1;

daysOfItems:
SELECT DISTINCT epoch_day FROM library_item WHERE id IN ?;

itemsById:
SELECT * FROM library_item WHERE id IN ?;

libraryDays:
SELECT min(epoch_day) AS first, max(epoch_day) AS last FROM library_item;

dirtyMarks:
SELECT day, n FROM feed_dirty;

markFeedDirty:
INSERT OR REPLACE INTO feed_dirty VALUES (?, (SELECT coalesce(max(n), 0) + 1 FROM feed_dirty));

-- A noting read by a refresh, unless the day was noted again since.
clearFeedMark:
DELETE FROM feed_dirty WHERE day = ? AND n = ?;

deleteSectionsOfDays:
DELETE FROM feed_section WHERE first_day <= :last AND last_day >= :first;

deleteAllSections:
DELETE FROM feed_section;

insertSection:
INSERT OR REPLACE INTO feed_section VALUES ?;

sectionsBefore:
SELECT * FROM feed_section WHERE newest_millis < ? ORDER BY newest_millis DESC, key ASC LIMIT ?;

sectionCount:
SELECT count(*) FROM feed_section;

-- Every row's newest moment, key and photos per day, newest first: the timeline of the whole feed.
timelineRows:
SELECT key, day_counts FROM feed_section ORDER BY newest_millis DESC, key ASC;

-- The rows from the newest down to the one with this key, which is read with them.
sectionsDownTo:
SELECT * FROM feed_section WHERE newest_millis >= (SELECT newest_millis FROM feed_section WHERE key = ?) ORDER BY newest_millis DESC, key ASC;

-- The key of the row a photo is in (its own day, or the day of the set it was merged into).
sectionOfDay:
SELECT key FROM feed_section WHERE first_day <= ? AND last_day >= ? ORDER BY newest_millis DESC LIMIT 1;

feedSounds:
SELECT * FROM feed_sound;

clearFeedSounds:
DELETE FROM feed_sound;

insertFeedSound:
INSERT OR REPLACE INTO feed_sound VALUES ?;

-- The days of the rows that have photos or recordings of the day.
sectionSpansOfDay:
SELECT first_day, last_day FROM feed_section WHERE first_day <= :day AND last_day >= :day;
