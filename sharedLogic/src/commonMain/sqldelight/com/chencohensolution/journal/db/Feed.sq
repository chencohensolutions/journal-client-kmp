-- Moments' rows (FeedTable): one per row of the feed, made a window of days at a time from library_item. A row keeps
-- its structure by item ids (data, JSON: FeedSectionData); the items themselves are read from library_item.
CREATE TABLE feed_section (
    key TEXT NOT NULL PRIMARY KEY,
    -- The oldest and newest days of its row, as days since 1970-01-01.
    first_day INTEGER NOT NULL,
    last_day INTEGER NOT NULL,
    -- Its newest moment: the feed's order, newest first.
    newest_millis INTEGER NOT NULL,
    data TEXT NOT NULL
);

CREATE INDEX feed_section_order ON feed_section(newest_millis);
CREATE INDEX feed_section_days ON feed_section(first_day, last_day);

-- Days whose items changed since Moments' rows were made, noted by the triggers on library_item; -1 for all of them.
CREATE TABLE feed_dirty (
    day INTEGER NOT NULL PRIMARY KEY
);

CREATE TRIGGER library_item_added AFTER INSERT ON library_item BEGIN INSERT OR IGNORE INTO feed_dirty VALUES (new.epoch_day); END;
CREATE TRIGGER library_item_changed AFTER UPDATE ON library_item BEGIN
    INSERT OR IGNORE INTO feed_dirty VALUES (old.epoch_day);
    INSERT OR IGNORE INTO feed_dirty VALUES (new.epoch_day);
END;
CREATE TRIGGER library_item_gone AFTER DELETE ON library_item BEGIN INSERT OR IGNORE INTO feed_dirty VALUES (old.epoch_day); END;
CREATE TRIGGER library_item_replacing BEFORE INSERT ON library_item BEGIN
    INSERT OR IGNORE INTO feed_dirty SELECT epoch_day FROM library_item WHERE id = new.id;
END;

-- A new database has no rows yet: make them all once.
INSERT INTO feed_dirty VALUES (-1);

-- The items of days first..last (as days since 1970-01-01), newest first, as LibraryController orders a day.
itemsOfDays:
SELECT * FROM library_item WHERE epoch_day BETWEEN ? AND ? ORDER BY taken_millis DESC, id ASC;

newestBeforeDay:
SELECT * FROM library_item WHERE epoch_day < ? ORDER BY epoch_day DESC, taken_millis DESC, id ASC LIMIT 1;

oldestAfterDay:
SELECT * FROM library_item WHERE epoch_day > ? ORDER BY epoch_day ASC, taken_millis ASC, id DESC LIMIT 1;

daysOfItems:
SELECT DISTINCT epoch_day FROM library_item WHERE id IN ?;

itemsById:
SELECT * FROM library_item WHERE id IN ?;

libraryDays:
SELECT min(epoch_day) AS first, max(epoch_day) AS last FROM library_item;

dirtyDays:
SELECT day FROM feed_dirty;

markFeedDirty:
INSERT OR IGNORE INTO feed_dirty VALUES (?);

clearFeedDirty:
DELETE FROM feed_dirty WHERE day IN ?;

clearAllFeedDirty:
DELETE FROM feed_dirty;

deleteSectionsOfDays:
DELETE FROM feed_section WHERE first_day <= :last AND last_day >= :first;

deleteAllSections:
DELETE FROM feed_section;

insertSection:
INSERT OR REPLACE INTO feed_section VALUES ?;

sectionsBefore:
SELECT * FROM feed_section WHERE newest_millis < ? ORDER BY newest_millis DESC, key ASC LIMIT ?;

sectionCount:
SELECT count(*) FROM feed_section;
