    <string name="sound_folders_a_title">Sound folders</string>
    <string name="sound_folders_a_intro">The folders your sound recordings came from. Merge each into Calls or Voice recordings, or keep it as a folder of its own: on all your devices.</string>
    <string name="sound_folders_a_footer">Nothing moves until you choose. WhatsApp voice messages always stay voice messages.</string>
