    <string name="cameras_b_move">העבר</string>
    <string name="cameras_b_confirm_body">הן נשארות בשרת שלך ובאפליקציה. הקש שלי כדי להחזיר אותן.</string>
    <string name="cameras_b_moving_body">בשרת שלך. אפשר לצאת מהעמוד; התמונות יתעדכנו ברגעים.</string>
