    <string name="cameras_b_title">המצלמות שלך</string>
    <string name="cameras_b_yours">שלך</string>
    <string name="cameras_b_yours_body">התמונות שלהן מופיעות תחת מצלמה. מצלמה שלא סימנת נמצאת כאן, כך ששום דבר לא זז עד שתבחר.</string>
    <string name="cameras_b_yours_none">אף מצלמה לא מסומנת כשלך.</string>
    <string name="cameras_b_others_body">מצלמות שאינן שלך: התמונות שלהן מופיעות תחת נשלח אליך, בכל המכשירים שלך.</string>
    <string name="cameras_b_others_none">עדיין אין מצלמה. הקש לא שלי על מצלמה שאינה שלך.</string>
    <string name="cameras_b_not_mine">לא שלי</string>
