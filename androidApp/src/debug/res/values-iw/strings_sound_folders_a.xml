<resources>
    <string name="sound_folders_a_title">תיקיות קול</string>
    <string name="sound_folders_a_intro">התיקיות שמהן הגיעו ההקלטות שלך. אפשר למזג כל אחת לשיחות או להקלטות קול, או להשאיר אותה תיקייה בפני עצמה: בכל המכשירים שלך.</string>
    <string name="sound_folders_a_footer">שום דבר לא זז עד שתבחר. הודעות קוליות מוואטסאפ נשארות תמיד הודעות קוליות.</string>
