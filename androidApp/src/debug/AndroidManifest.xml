<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the UI lab (UiLabActivity), which shows the app's screens with made-up data, and trust in the
     local test server's CA (res/xml/network_security_config.xml). Release builds never see this file or src/debug. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:exported="true"
            android:label="Journal UI lab"
            android:name=".ui.library.UiLabActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
